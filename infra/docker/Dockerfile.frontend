# Multi-stage build: compile the Vite app, then serve the static output
# with nginx — the frontend has no server-side runtime, so shipping a
# Node process for it in production would be pure waste.

FROM node:20-slim AS build
WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci

COPY . .
# VITE_API_URL/VITE_WS_URL are baked into the static JS bundle at build
# time (Vite has no server to read env vars from at runtime) — pass them
# as build args so the same Dockerfile works for compose (localhost) and
# a real deployment (a public domain) without editing this file.
ARG VITE_API_URL=http://localhost:8000/api/v1
ARG VITE_WS_URL=ws://localhost:8000/api/v1
ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_WS_URL=${VITE_WS_URL}
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
# Lives inside frontend/ (not infra/docker/) because this Dockerfile's
# build context is scoped to frontend/ — same convention Dockerfile.backend
# uses (context = backend/): COPY can only reach files inside the context,
# regardless of where the Dockerfile itself is stored.
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80

HEALTHCHECK --interval=10s --timeout=5s --retries=5 --start-period=5s \
    CMD wget -qO- http://localhost/ || exit 1
