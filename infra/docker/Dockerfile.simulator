# Demo telemetry source: runs edge/telemetry_publisher/simulate.py (the physics-based EngineSimulator)
# so the demo engine streams continuously whenever Docker is up. DEVELOPMENT/DEMO ONLY — never point
# this at a production broker or a real engine's ID: it publishes synthetic readings.
#
# The code is bind-mounted read-only by docker-compose (edge/telemetry_publisher and ml/training), so
# this image is just Python + the one dependency.
FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir paho-mqtt
ENV PYTHONUNBUFFERED=1
CMD ["python", "edge/telemetry_publisher/simulate.py", "--host", "mqtt", "--rate", "1.0"]
