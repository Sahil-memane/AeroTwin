# Copy to .env.prod (never commit it). Every value marked REQUIRED must be set.
DOMAIN=twin.example.com                 # REQUIRED  public hostname; DNS A record -> the VM's static IP
ACME_EMAIL=ops@example.com              # REQUIRED  Let's Encrypt registration
POSTGRES_PASSWORD=                      # REQUIRED  openssl rand -hex 24
JWT_SECRET=                             # REQUIRED  openssl rand -hex 32
EDGE_API_KEY=                           # REQUIRED  openssl rand -hex 16 (edge agents send this on the REST ingest path)
POSTGRES_USER=aerotwin
POSTGRES_DB=aerotwin
IMAGE_TAG=latest
LLM_PROVIDER=gemini                     # gemini | groq | ollama (Copilot; optional)
GEMINI_API_KEY=
GROQ_API_KEY=
MQTT_EDGE_BIND=127.0.0.1                # 0.0.0.0 only after enabling TLS in mosquitto.prod.conf
BACKEND_MEM_LIMIT=5g                    # 5g on an 8 GB VM (e2-standard-2); 2500m on a 4 GB VM (e2-medium)
