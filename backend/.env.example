# ── AeroTwin Backend Environment Variables ──
# Copy this file to .env and fill in the values

DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/aerotwin
JWT_SECRET=supersecretkeyforlocaldev123
ACCESS_TOKEN_EXPIRE_MINUTES=11520
REFRESH_TOKEN_EXPIRE_MINUTES=43200
MQTT_BROKER_URL=mqtt://localhost:1883
REDIS_URL=redis://localhost:6379/0
EDGE_API_KEY=changeme-edge-api-key
ALERT_COOLDOWN_MINUTES=5

# ── Deployment ──
# ENVIRONMENT=production makes the app refuse to start with the placeholder
# secrets above or a wildcard CORS origin. In production set:
#   JWT_SECRET      >= 32 random chars     (e.g. `openssl rand -hex 32`)
#   EDGE_API_KEY    >= 16 random chars
#   CORS_ORIGINS    https://your-frontend.example.com  (comma-separated)
ENVIRONMENT=development
CORS_ORIGINS=*

# Health Fusion ignores stored predictions older than this (seconds).
HEALTH_FUSION_MAX_PREDICTION_AGE_SECONDS=60
HEALTH_SCORE_STALE_AFTER_SECONDS=300

# ── Copilot LLM provider (backend/AeroTwin_Rag/llm_providers.py) ──
# One of: groq | gemini | ollama. "gemini" keeps existing behavior;
# switch to "groq" once GROQ_API_KEY is set for a free/low-cost primary.
LLM_PROVIDER=gemini
LLM_FALLBACK_ENABLED=true

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional local fallback — no API key needed, requires an Ollama
# server running locally with OLLAMA_MODEL already pulled.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=