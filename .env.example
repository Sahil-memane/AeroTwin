# ── AeroTwin Root Environment Variables ──
# Copy this file to .env and fill in the values

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aerotwin

# Security
JWT_SECRET=change-me-to-a-random-secret

# Token expiry (in minutes) — default: 8 days = 11520
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# MQTT Broker
MQTT_BROKER_URL=mqtt://localhost:1883

# Redis
REDIS_URL=redis://localhost:6379/0
